{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# Agent Builder Infrastructure Dashboard\n\nReal-time monitoring of ECS services, RDS database, and ALB metrics"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Backend CPU Utilization",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/ECS",
            "CPUUtilization",
            "ClusterName",
            "${ECS_CLUSTER}",
            "ServiceName",
            "${BACKEND_SERVICE}"
          ]
        ],
        "period": 300,
        "stat": "Average",
        "view": "timeSeries",
        "stacked": false,
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100
          }
        },
        "annotations": {
          "horizontal": [
            {
              "label": "Warning",
              "value": 70,
              "color": "#ff7f0e"
            },
            {
              "label": "Critical",
              "value": 85,
              "color": "#d62728"
            }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 6,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Backend Memory Utilization",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/ECS",
            "MemoryUtilization",
            "ClusterName",
            "${ECS_CLUSTER}",
            "ServiceName",
            "${BACKEND_SERVICE}"
          ]
        ],
        "period": 300,
        "stat": "Average",
        "view": "timeSeries",
        "stacked": false,
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100
          }
        },
        "annotations": {
          "horizontal": [
            {
              "label": "Warning",
              "value": 70,
              "color": "#ff7f0e"
            },
            {
              "label": "Critical",
              "value": 85,
              "color": "#d62728"
            }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Frontend CPU Utilization",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/ECS",
            "CPUUtilization",
            "ClusterName",
            "${ECS_CLUSTER}",
            "ServiceName",
            "${FRONTEND_SERVICE}"
          ]
        ],
        "period": 300,
        "stat": "Average",
        "view": "timeSeries",
        "stacked": false,
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 18,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Frontend Memory Utilization",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/ECS",
            "MemoryUtilization",
            "ClusterName",
            "${ECS_CLUSTER}",
            "ServiceName",
            "${FRONTEND_SERVICE}"
          ]
        ],
        "period": 300,
        "stat": "Average",
        "view": "timeSeries",
        "stacked": false,
        "yAxis": {
          "left": {
            "min": 0,
            "max": 100
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 7,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "RDS CPU Utilization",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/RDS",
            "CPUUtilization",
            "DBInstanceIdentifier",
            "${RDS_INSTANCE}"
          ]
        ],
        "period": 300,
        "stat": "Average",
        "view": "timeSeries",
        "annotations": {
          "horizontal": [
            {
              "label": "High",
              "value": 80,
              "color": "#d62728"
            }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 7,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "RDS Database Connections",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/RDS",
            "DatabaseConnections",
            "DBInstanceIdentifier",
            "${RDS_INSTANCE}"
          ]
        ],
        "period": 300,
        "stat": "Average",
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 7,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "RDS Free Storage Space (GB)",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/RDS",
            "FreeStorageSpace",
            "DBInstanceIdentifier",
            "${RDS_INSTANCE}",
            {
              "id": "m1"
            }
          ]
        ],
        "period": 300,
        "stat": "Average",
        "view": "timeSeries",
        "yAxis": {
          "left": {
            "label": "Bytes",
            "showUnits": false
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 13,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB Request Count",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "RequestCount",
            "LoadBalancer",
            "${ALB_ARN_SUFFIX}",
            {
              "stat": "Sum"
            }
          ]
        ],
        "period": 60,
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 13,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB Response Time (p50, p90, p99)",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "TargetResponseTime",
            "LoadBalancer",
            "${ALB_ARN_SUFFIX}",
            {
              "stat": "p50",
              "label": "p50"
            }
          ],
          [
            "...",
            {
              "stat": "p90",
              "label": "p90"
            }
          ],
          [
            "...",
            {
              "stat": "p99",
              "label": "p99"
            }
          ]
        ],
        "period": 60,
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 19,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "HTTP Error Codes",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "HTTPCode_ELB_4XX_Count",
            "LoadBalancer",
            "${ALB_ARN_SUFFIX}",
            {
              "label": "4XX (ELB)",
              "color": "#ff7f0e"
            }
          ],
          [
            ".",
            "HTTPCode_ELB_5XX_Count",
            ".",
            ".",
            {
              "label": "5XX (ELB)",
              "color": "#d62728"
            }
          ],
          [
            ".",
            "HTTPCode_Target_4XX_Count",
            ".",
            ".",
            {
              "label": "4XX (Target)",
              "color": "#9467bd"
            }
          ],
          [
            ".",
            "HTTPCode_Target_5XX_Count",
            ".",
            ".",
            {
              "label": "5XX (Target)",
              "color": "#8c564b"
            }
          ]
        ],
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 19,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Healthy vs Unhealthy Hosts",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "HealthyHostCount",
            "LoadBalancer",
            "${ALB_ARN_SUFFIX}",
            "TargetGroup",
            "${BACKEND_TG_ARN_SUFFIX}",
            {
              "label": "Backend Healthy",
              "color": "#2ca02c"
            }
          ],
          [
            ".",
            "UnHealthyHostCount",
            ".",
            ".",
            ".",
            ".",
            {
              "label": "Backend Unhealthy",
              "color": "#d62728"
            }
          ],
          [
            ".",
            "HealthyHostCount",
            ".",
            ".",
            "TargetGroup",
            "${FRONTEND_TG_ARN_SUFFIX}",
            {
              "label": "Frontend Healthy",
              "color": "#1f77b4"
            }
          ],
          [
            ".",
            "UnHealthyHostCount",
            ".",
            ".",
            ".",
            ".",
            {
              "label": "Frontend Unhealthy",
              "color": "#ff7f0e"
            }
          ]
        ],
        "period": 60,
        "stat": "Average",
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 25,
      "width": 8,
      "height": 4,
      "properties": {
        "title": "Backend Running Tasks",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "ECS/ContainerInsights",
            "RunningTaskCount",
            "ClusterName",
            "${ECS_CLUSTER}",
            "ServiceName",
            "${BACKEND_SERVICE}"
          ]
        ],
        "period": 60,
        "stat": "Average",
        "view": "singleValue"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 25,
      "width": 8,
      "height": 4,
      "properties": {
        "title": "Frontend Running Tasks",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "ECS/ContainerInsights",
            "RunningTaskCount",
            "ClusterName",
            "${ECS_CLUSTER}",
            "ServiceName",
            "${FRONTEND_SERVICE}"
          ]
        ],
        "period": 60,
        "stat": "Average",
        "view": "singleValue"
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 25,
      "width": 8,
      "height": 4,
      "properties": {
        "title": "Total Requests (Last Hour)",
        "region": "${AWS_REGION}",
        "metrics": [
          [
            "AWS/ApplicationELB",
            "RequestCount",
            "LoadBalancer",
            "${ALB_ARN_SUFFIX}"
          ]
        ],
        "period": 3600,
        "stat": "Sum",
        "view": "singleValue"
      }
    }
  ]
}
