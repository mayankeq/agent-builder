# Agent-Builder Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Required: LLM API Keys (at least one)
# ============================================

# Anthropic Claude (Recommended)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Additional LLM Providers
# OPENAI_API_KEY=sk-your-openai-key
# AZURE_OPENAI_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com
# GEMINI_API_KEY=your-gemini-key

# ============================================
# Database (Auto-configured in Docker)
# ============================================
# Updated to match Docker Compose configuration
DATABASE_URL=postgresql://agent_user:agent_pass@postgres:5432/agent_builder

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000

# JWT Secret (auto-generated if not provided)
JWT_SECRET=your-random-secret-key-change-this-in-production

# API Key Encryption (auto-generated if not provided)
ENCRYPTION_KEY=your-random-encryption-key-change-this

# ============================================
# OAuth (Optional - For Web App SSO)
# ============================================

# Google OAuth
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Azure AD OAuth
# AZURE_CLIENT_ID=your-azure-client-id
# AZURE_CLIENT_SECRET=your-azure-client-secret
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CALLBACK_URL=http://localhost:3000/api/auth/azure/callback

# Okta OAuth
# OKTA_DOMAIN=your-company.okta.com
# OKTA_CLIENT_ID=your-okta-client-id
# OKTA_CLIENT_SECRET=your-okta-client-secret
# OKTA_CALLBACK_URL=http://localhost:3000/api/auth/okta/callback

# ============================================
# Storage (Optional - Uses local storage in dev)
# ============================================

# AWS S3 (Optional in development)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_ARTIFACTS_BUCKET=agent-builder-artifacts

# Local Storage (Default for development)
LOCAL_STORAGE_PATH=./artifacts

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ============================================
# Redis (Optional - Auto-configured in Docker)
# ============================================
# REDIS_URL=redis://redis:6379

# ============================================
# Monitoring (Optional)
# ============================================
# LOG_LEVEL=info
# ENABLE_METRICS=true
