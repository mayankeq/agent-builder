#!/usr/bin/env node
/**
 * {{name}} - Context-Aware AI Agent
 * Generated by Synthient Agent Builder
 *
 * This agent automatically indexes your {{projectType}} project and provides
 * context-aware assistance using RAG (Retrieval Augmented Generation).
 */

import { ProjectScanner } from './src/scanner';
import { VectorStore } from './src/vector-store';
import { ContextRetriever } from './src/context-retriever';
import { AgentCore } from './src/agent-core';
import * as path from 'path';
import * as os from 'os';

// Context storage directory
const CONTEXT_DIR = path.join(os.homedir(), '.synthient', 'contexts');

/**
 * Main agent class
 */
export class {{pascalCase name}}Agent {
  private scanner: ProjectScanner;
  private vectorStore: VectorStore;
  private contextRetriever: ContextRetriever;
  private agentCore: AgentCore;
  private initialized = false;

  constructor(private projectPath?: string) {
    this.projectPath = projectPath || process.cwd();

    const contextPath = path.join(
      CONTEXT_DIR,
      path.basename(this.projectPath)
    );

    this.scanner = new ProjectScanner(this.projectPath, {
      fileTypes: [{{#each fileTypes}}'{{this}}'{{#unless @last}}, {{/unless}}{{/each}}],
      excludeDirs: ['node_modules', 'dist', 'build', 'target', '.git'],
    });

    this.vectorStore = new VectorStore(contextPath);
    this.contextRetriever = new ContextRetriever(this.vectorStore);
    this.agentCore = new AgentCore(this.contextRetriever);
  }

  /**
   * Initialize agent - scan project and build context
   */
  async initialize(force = false): Promise<void> {
    if (this.initialized && !force) {
      return;
    }

    console.log(`🔍 Scanning {{projectType}} project: ${this.projectPath}`);

    // Check if context already exists
    const contextExists = await this.vectorStore.exists();

    if (contextExists && !force) {
      console.log('✅ Using existing context index');
      await this.vectorStore.load();
      this.initialized = true;
      return;
    }

    // Scan project
    console.log('📂 Analyzing project structure...');
    const files = await this.scanner.scanProject();
    console.log(`Found ${files.length} files`);

    // Extract and index code
    console.log('🧠 Building knowledge base...');
    const codeChunks = await this.scanner.extractCodeChunks(files);
    await this.vectorStore.indexChunks(codeChunks);

    console.log('✅ Context index built successfully');
    this.initialized = true;
  }

  /**
   * Query the agent with context awareness
   */
  async query(question: string): Promise<string> {
    if (!this.initialized) {
      await this.initialize();
    }

    // Retrieve relevant context
    const relevantContext = await this.contextRetriever.retrieve(question, {
      topK: 5,
      minSimilarity: 0.7,
    });

    // Generate response with context
    const response = await this.agentCore.generate(question, relevantContext);

    return response;
  }

  /**
   * Analyze specific file or class
   */
  async analyze(target: string): Promise<any> {
    if (!this.initialized) {
      await this.initialize();
    }

    const targetPath = path.isAbsolute(target)
      ? target
      : path.join(this.projectPath, target);

    const analysis = await this.scanner.analyzeFile(targetPath);
    return analysis;
  }

  /**
   * Get project statistics
   */
  async getStats(): Promise<any> {
    if (!this.initialized) {
      await this.initialize();
    }

    return {
      projectPath: this.projectPath,
      indexedChunks: await this.vectorStore.getCount(),
      lastUpdated: await this.vectorStore.getLastUpdate(),
    };
  }

  /**
   * Refresh context index
   */
  async refresh(): Promise<void> {
    console.log('🔄 Refreshing context index...');
    await this.initialize(true);
  }
}

// CLI interface
if (require.main === module) {
  const args = process.argv.slice(2);
  const command = args[0];

  const agent = new {{pascalCase name}}Agent(process.env.PROJECT_PATH);

  (async () => {
    switch (command) {
      case 'setup':
      case 'init':
        await agent.initialize(true);
        console.log('✅ Setup complete! Agent is ready to use.');
        break;

      case 'query':
        const question = args.slice(1).join(' ');
        const answer = await agent.query(question);
        console.log(answer);
        break;

      case 'analyze':
        const target = args[1];
        const analysis = await agent.analyze(target);
        console.log(JSON.stringify(analysis, null, 2));
        break;

      case 'stats':
        const stats = await agent.getStats();
        console.log(JSON.stringify(stats, null, 2));
        break;

      case 'refresh':
        await agent.refresh();
        break;

      default:
        console.log(`
{{name}} - Context-Aware AI Agent

Usage:
  node index.js <command> [options]

Commands:
  setup          Initialize and scan project
  query <text>   Ask a question about your project
  analyze <file> Analyze a specific file
  stats          Show index statistics
  refresh        Rebuild context index

Examples:
  node index.js setup
  node index.js query "What design patterns are used?"
  node index.js analyze src/Main.java
        `);
    }
  })().catch(console.error);
}

export default {{pascalCase name}}Agent;
