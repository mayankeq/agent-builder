import type { ContextRetriever, ContextResult } from './context-retriever';

/**
 * Agent Core - Generates context-aware responses
 * Integrates with Claude for intelligent responses
 */
export class AgentCore {
  constructor(private contextRetriever: ContextRetriever) {}

  /**
   * Generate response to query with retrieved context
   */
  async generate(query: string, context: ContextResult): Promise<string> {
    // Build prompt with context
    const prompt = this.buildPrompt(query, context);

    // For demo: return formatted response
    // In production: call Claude API with context
    return this.generateResponse(query, context);
  }

  /**
   * Build prompt with retrieved context
   */
  private buildPrompt(query: string, context: ContextResult): string {
    const contextStr = this.contextRetriever.formatContextForPrompt(context);

    return `You are an expert {{projectType}} developer assistant with deep knowledge of this codebase.

${contextStr}

User Question: ${query}

Please provide a detailed, accurate answer based on the retrieved context. Reference specific files, classes, or methods when relevant.`;
  }

  /**
   * Generate response (placeholder - integrate with Claude in production)
   */
  private generateResponse(query: string, context: ContextResult): string {
    if (context.chunks.length === 0) {
      return `I don't have enough context to answer: "${query}"\n\nPlease ensure the project has been indexed (run setup) or try rephrasing your question.`;
    }

    // Format context-aware response
    let response = `Based on the codebase analysis:\n\n`;

    // Add summary
    response += `${context.summary}\n\n`;

    // Add relevant chunks
    response += `**Relevant Code:**\n\n`;
    context.chunks.slice(0, 3).forEach((chunk, i) => {
      response += `${i + 1}. **${chunk.name}** (${chunk.type}) in \`${chunk.filePath}\`\n`;
      response += `   Lines ${chunk.lineStart}-${chunk.lineEnd}\n`;

      // Show snippet
      const lines = chunk.content.split('\n');
      const snippet = lines.slice(0, 5).join('\n');
      response += `   \`\`\`\n${snippet}${lines.length > 5 ? '\n   ...' : ''}\n   \`\`\`\n\n`;
    });

    // Add answer placeholder
    response += `\n**Answer:**\n`;
    response += `[In production, this would be generated by Claude using the above context]\n\n`;

    // Suggest follow-up
    response += `**Tip:** For AI-generated answers, integrate Claude API in agent-core.ts\n`;

    return response;
  }
}
