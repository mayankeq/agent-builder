{
  "name": "@agent-builder/cli",
  "version": "0.1.0",
  "description": "A comprehensive CLI tool for building LLM-based agents with extended thinking and self-improvement",
  "main": "dist/index.js",
  "bin": {
    "agent-builder": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:server": "node dist/server/index.js",
    "dev:server": "tsc --watch & nodemon dist/server/index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "agent",
    "ai",
    "llm",
    "claude",
    "anthropic",
    "agent-builder",
    "automation",
    "cli",
    "mcp",
    "extended-thinking",
    "code-generation"
  ],
  "author": "Agent-Builder Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/agent-builder.git"
  },
  "homepage": "https://github.com/YOUR_USERNAME/agent-builder#readme",
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/agent-builder/issues"
  },
  "files": [
    "dist",
    "templates",
    "config",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/lib-storage": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@lancedb/lancedb": "^0.5.2",
    "archiver": "^6.0.1",
    "chalk": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "inquirer": "^9.2.12",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.28.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "yaml": "^2.3.4",
    "yargs": "^17.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "typescript": "^5.8.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
