# =============================================================================
# Agent Builder - Backend Dockerfile
# =============================================================================
# Multi-stage build for development and production
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Dependencies
# -----------------------------------------------------------------------------
FROM node:20-alpine AS deps

# Add necessary build tools for native modules
RUN apk add --no-cache \
    libc6-compat \
    python3 \
    make \
    g++ \
    curl

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install all dependencies (including devDependencies for building)
RUN npm ci --legacy-peer-deps

# -----------------------------------------------------------------------------
# Stage 2: Builder (TypeScript compilation)
# -----------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code and configuration
COPY . .

# Build the application
RUN npm run build

# Prune devDependencies for production
RUN npm prune --production --legacy-peer-deps

# -----------------------------------------------------------------------------
# Stage 3: Development (hot reload)
# -----------------------------------------------------------------------------
FROM node:20-alpine AS development

# Add labels
LABEL org.opencontainers.image.title="Agent Builder Backend (Development)"
LABEL org.opencontainers.image.description="LLM-based agent builder backend - development mode"

# Install curl for health checks and nodemon for hot reload
RUN apk add --no-cache curl

WORKDIR /app

# Copy all dependencies (including dev dependencies)
COPY --from=deps /app/node_modules ./node_modules

# Copy source code and configuration
COPY package.json ./
COPY tsconfig.json ./
COPY src ./src
COPY config ./config
COPY templates ./templates
COPY scripts ./scripts

# Create directories for runtime data
RUN mkdir -p /app/artifacts /app/data /app/logs

# Set environment variables
ENV NODE_ENV=development \
    PORT=3000 \
    HOST=0.0.0.0

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Use ts-node for development with watch mode
# First build, then watch for changes
CMD npm run build && npm run dev:server

# -----------------------------------------------------------------------------
# Stage 4: Production (optimized)
# -----------------------------------------------------------------------------
FROM node:20-alpine AS production

# Add labels
LABEL org.opencontainers.image.title="Agent Builder Backend (Production)"
LABEL org.opencontainers.image.description="LLM-based agent builder backend - production mode"
LABEL org.opencontainers.image.vendor="Agent Builder"

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 agentbuilder

WORKDIR /app

# Set environment variables
ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0

# Copy built application from builder
COPY --from=builder --chown=agentbuilder:nodejs /app/dist ./dist
COPY --from=builder --chown=agentbuilder:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=agentbuilder:nodejs /app/package.json ./package.json

# Copy configuration files
COPY --chown=agentbuilder:nodejs config ./config
COPY --chown=agentbuilder:nodejs templates ./templates
COPY --chown=agentbuilder:nodejs scripts ./scripts

# Create directories for runtime data
RUN mkdir -p /app/artifacts /app/data /app/logs && \
    chown -R agentbuilder:nodejs /app/artifacts /app/data /app/logs

# Install curl for health checks
RUN apk add --no-cache curl

# Switch to non-root user
USER agentbuilder

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Start the application
CMD ["node", "dist/server/index.js"]
